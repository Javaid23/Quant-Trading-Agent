ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# LLM for plain-language explanations. Provider is chosen by whichever key is set:
# Groq (gsk_..., recommended free tier) -> xAI/Grok (xai-...) -> Featherless -> deterministic.
# An xAI key pasted into GROQ_API_KEY is auto-routed to xAI by its 'xai-' prefix.
GROQ_API_KEY=
# Optional: override the Groq model (default llama-3.1-8b-instant). Alternatives:
# llama-3.3-70b-versatile (higher quality), openai/gpt-oss-20b
# GROQ_MODEL=

# xAI / Grok (needs account credits). Default model grok-3-mini.
XAI_API_KEY=
# GROQ_MODEL / XAI_MODEL override the model per provider.
# XAI_MODEL=

FEATHERLESS_API_KEY=
# Optional: the default Featherless model (meta-llama/Meta-Llama-3.1-8B-Instruct) is
# gated and needs a HuggingFace OAuth link; set a non-gated model instead, e.g.:
# FEATHERLESS_MODEL=
